# Oracle Free image. Keep this on latest unless a fixed version is preferred.
ORACLE_IMAGE=gvenzl/oracle-free:latest

# Container settings
ORACLE_CONTAINER_NAME=oracle
ORACLE_RESTART_POLICY=unless-stopped

# SYS, SYSTEM and PDBADMIN password (minimum 8 characters).
ORACLE_PASSWORD=changeme123

# Database and character set created on first run.
ORACLE_DATABASE=FREE
ORACLE_CHARACTERSET=AL32UTF8

# Optional application schema created on first run.
ORACLE_APP_USER=appuser
ORACLE_APP_PASSWORD=changeme123

# Set to true only when archive logging is required.
ORACLE_ENABLE_ARCHIVELOG=false

# Host ports.
ORACLE_PORT=1521
ORACLE_EM_PORT=5500

# Healthcheck settings.
ORACLE_HEALTHCHECK_INTERVAL=10s
ORACLE_HEALTHCHECK_TIMEOUT=5s
ORACLE_HEALTHCHECK_RETRIES=10
ORACLE_HEALTHCHECK_START_PERIOD=60s
